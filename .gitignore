# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env holds AUTH_SECRET and the database URL, never commit it.
# .env.example is the setup template and carries no secrets, so it is kept.
.env*
!.env.example

# SQLite database — contains seeded content AND real user accounts with
# password hashes. It is rebuilt from source with `npm run setup`, so there is
# nothing to gain by committing it and a lot to lose.
*.db
*.db-journal
*.db-wal
*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
