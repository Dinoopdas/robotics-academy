# Database ------------------------------------------------------------------
# SQLite is the zero-setup default: the file is created on `npm run db:push`.
DATABASE_URL="file:./dev.db"
#
# To move to PostgreSQL: set the URL below, change `provider` in
# prisma/schema.prisma to "postgresql", swap the adapter in src/lib/db.ts to
# @prisma/adapter-pg, then re-run `npm run db:push`. No model changes needed.
# DATABASE_URL="postgresql://user:password@localhost:5432/robotics_academy"

# Auth -----------------------------------------------------------------------
# Signs session cookies. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Public site URL, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@robotics.academy"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
