# Database ------------------------------------------------------------------
# PostgreSQL connection string. Free options: Neon, Supabase, Prisma Postgres.
# For an instant throwaway database (no signup):  npx create-db@latest
#
# Host it in the SAME REGION as the app. Every page here makes several queries,
# so a cross-continent database turns a 300 ms page into a 5 second one — that
# single choice matters more for perceived speed than anything in the code.
#
# Note on SSL: the `pg` driver currently treats sslmode=require as verify-full,
# and warns that a future major version will relax it. Managed providers (Neon,
# Supabase, Prisma Postgres) all present valid certificates, so you can silence
# the warning and pin the stricter behaviour with sslmode=verify-full.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth -----------------------------------------------------------------------
# Signs session cookies. MUST be changed before deploying. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Public site URL — drives canonical links, Open Graph tags and the sitemap.
# In production set this to your real domain, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed admin account ---------------------------------------------------------
# Optional. If both are set, `npm run db:seed` creates an admin with these
# credentials. Leave them unset in production and let the first person to sign
# up become the admin instead — that way no password is ever written down.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
